# Copyright (c) 2026 Torviello.
# Engine runtime configuration example — this unit owns it; the modular
# monolith keeps each module's env at the module root, never at the
# repository root. Secrets stay empty and are injected at runtime.

TORCH_HOST=127.0.0.1
TORCH_PORT=8000
TORCH_AUTH_ENABLED=true
TORCH_AUTH_MODE=local
TORCH_OIDC_CLOCK_SKEW_SECONDS=60
TORCH_AUTH_JWT_SECRET=
TORCH_TLS_CERT=
TORCH_TLS_KEY=
INFERENCE_MAX_BODY_BYTES=1048576
TORCH_MODEL_REGISTRY=config/model-registry.toml
TORCH_DATABASE_URL=sqlite://data/engine.db
TORCH_MODEL_ROOT=models
TORCH_MAX_MODEL_BYTES=1073741824
TORCH_MAX_LOADED_MODELS=2
TORCH_DOWNLOAD_CONCURRENCY=2
TORCH_DOWNLOAD_TIMEOUT_MS=300000
TORCH_MODEL_SOURCE_ALLOWLIST=huggingface.co,cdn-lfs.huggingface.co,models.torviello.local
