{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/catalog/ModelSummary.schema.json",
  "title": "ModelSummary",
  "type": "object",
  "required": [
    "model_id",
    "task",
    "format",
    "catalog_present",
    "locally_available",
    "download_state",
    "load_state"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "enum": [
        "tts",
        "stt",
        "classification",
        "detection",
        "chat",
        "tensor"
      ]
    },
    "format": {
      "type": "string"
    },
    "catalog_present": {
      "type": "boolean"
    },
    "locally_available": {
      "type": "boolean"
    },
    "download_state": {
      "type": "string",
      "enum": [
        "absent",
        "queued",
        "downloading",
        "verifying",
        "ready",
        "failed",
        "cancelled"
      ]
    },
    "load_state": {
      "type": "string",
      "enum": [
        "unloaded",
        "queued",
        "loading",
        "ready",
        "draining",
        "failed"
      ]
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
