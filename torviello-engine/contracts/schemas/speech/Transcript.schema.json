{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/speech/Transcript.schema.json",
  "title": "Transcript",
  "type": "object",
  "required": [
    "text",
    "language",
    "duration_ms"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "type": "integer"
          },
          "end_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
