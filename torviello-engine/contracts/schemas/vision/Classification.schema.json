{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/vision/Classification.schema.json",
  "title": "Classification",
  "type": "object",
  "required": [
    "index",
    "predictions"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "score"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
