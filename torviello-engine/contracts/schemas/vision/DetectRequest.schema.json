{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/vision/DetectRequest.schema.json",
  "title": "DetectRequest",
  "type": "object",
  "required": [
    "image",
    "model_id"
  ],
  "properties": {
    "image": {
      "type": "string",
      "format": "binary"
    },
    "model_id": {
      "type": "string"
    },
    "confidence_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.25
    },
    "iou_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.45
    },
    "max_detections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 300
    }
  }
}
