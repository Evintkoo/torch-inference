{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/vision/ClassifyRequest.schema.json",
  "title": "ClassifyRequest",
  "type": "object",
  "required": [
    "images",
    "model_id"
  ],
  "properties": {
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "format": "binary"
      }
    },
    "model_id": {
      "type": "string"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 5
    }
  }
}
