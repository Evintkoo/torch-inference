{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/vision/DetectionResult.schema.json",
  "title": "DetectionResult",
  "type": "object",
  "required": [
    "detections"
  ],
  "properties": {
    "detection_count": {
      "type": "integer",
      "minimum": 0
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_id",
          "label",
          "confidence",
          "box"
        ],
        "properties": {
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "box": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
