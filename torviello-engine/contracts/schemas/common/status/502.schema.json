{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/common/status/502.schema.json",
  "title": "502 Bad Gateway",
  "description": "RFC 9110 \u00a715.6.3; class server_error; engine use: used.\nTrigger: An optional upstream returned an invalid response or failed before completion.\nContent: application/problem+json (ErrorEnvelope).\nRequired headers: none.\nCache-Control: no-store; retry: conditional.",
  "x-status": 502,
  "x-engine-use": "used",
  "x-response-body": "problem+json",
  "x-response-contract": {
    "content_type": "application/problem+json",
    "schema": "ErrorEnvelope",
    "required_headers": [],
    "optional_headers": [],
    "cache_control": "no-store",
    "retry": "conditional",
    "body_fields": [
      "type",
      "title",
      "status",
      "code",
      "category",
      "detail",
      "instance",
      "request_id",
      "retryable"
    ],
    "forbidden_body_fields": [
      "data"
    ],
    "error_codes": [
      "model.source_unavailable"
    ],
    "error_category": "upstream",
    "retryable": true,
    "trigger": "An optional upstream returned an invalid response or failed before completion."
  },
  "$ref": "../ErrorEnvelope.schema.json",
  "examples": [
    {
      "type": "https://torviello.local/problems/model-source_unavailable",
      "title": "Bad Gateway",
      "status": 502,
      "code": "model.source_unavailable",
      "category": "upstream",
      "detail": "An optional upstream returned an invalid response or failed before completion.",
      "instance": "urn:torviello:request:00000000-0000-4000-8000-000000000000",
      "request_id": "00000000-0000-4000-8000-000000000000",
      "retryable": true,
      "retry_after_ms": 60000
    }
  ]
}
