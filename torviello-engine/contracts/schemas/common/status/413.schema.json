      "payload_too_large",
      "model.too_large"
    ],
    "error_category": "validation",
    "retryable": false,
    "trigger": "The request body, batch, frame, or artifact exceeds the configured limit."
  },
  "$ref": "../ErrorEnvelope.schema.json",
  "examples": [
