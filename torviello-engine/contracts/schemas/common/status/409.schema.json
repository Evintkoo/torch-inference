    "content_type": "application/problem+json",
    "schema": "ErrorEnvelope",
    "required_headers": [],
    "optional_headers": [],
    "cache_control": "no-store",
    "retry": "never",
    "body_fields": [
      "type",
      "title",
      "status",
      "code",
      "category",
      "detail",
      "instance",
      "request_id",
      "retryable"
    ],
