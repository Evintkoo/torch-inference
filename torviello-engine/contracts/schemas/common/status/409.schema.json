{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/schemas/common/status/409.schema.json",
  "title": "409 Conflict",
  "description": "RFC 9110 \u00a715.5.10; class client_error; engine use: used.\nTrigger: The request conflicts with model, job, capacity, or unload state.\nContent: application/problem+json (ErrorEnvelope).\nRequired headers: none.\nCache-Control: no-store; retry: never.",
  "x-status": 409,
