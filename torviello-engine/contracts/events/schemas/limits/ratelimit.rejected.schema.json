{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/limits/ratelimit.rejected.schema.json",
  "title": "ratelimit.rejected",
  "description": "A client exceeds its request budget.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "route_group",
    "retry_after_ms",
    "identity_source"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "ratelimit.rejected"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "route_group": {
      "type": "string"
    },
    "retry_after_ms": {
      "type": "integer"
    },
    "identity_source": {
      "type": "string"
    }
  },
  "x-requirement": "ENG-015"
}
