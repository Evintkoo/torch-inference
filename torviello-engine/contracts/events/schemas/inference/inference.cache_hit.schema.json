{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/inference/inference.cache_hit.schema.json",
  "title": "inference.cache_hit",
  "description": "A valid cached result is returned.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "request_id",
    "model_id",
    "cache_key_hash",
    "age_ms"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "inference.cache_hit"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "cache_key_hash": {
      "type": "string"
    },
    "age_ms": {
      "type": "integer"
    }
  },
  "x-requirement": "ENG-014"
}
