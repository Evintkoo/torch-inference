{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/inference/inference.failed.schema.json",
  "title": "inference.failed",
  "description": "Execution fails.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "request_id",
    "model_id",
    "backend",
    "error_code",
    "latency_ms"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "inference.failed"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "latency_ms": {
      "type": "number"
    }
  },
  "x-requirement": "ENG-017"
}
