{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/inference/inference.batched.schema.json",
  "title": "inference.batched",
  "description": "A request joins a batch.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "request_id",
    "batch_id",
    "batch_size",
    "wait_duration_ms"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "inference.batched"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "batch_size": {
      "type": "integer"
    },
    "wait_duration_ms": {
      "type": "integer"
    }
  },
  "x-requirement": "ENG-014"
}
