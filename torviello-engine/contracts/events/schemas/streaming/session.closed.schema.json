{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/streaming/session.closed.schema.json",
  "title": "session.closed",
  "description": "The session ends.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "session_id",
    "reason",
    "duration_ms",
    "active_work_cancelled"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "session.closed"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer"
    },
    "active_work_cancelled": {
      "type": "boolean"
    }
  },
  "x-requirement": "ENG-013"
}
