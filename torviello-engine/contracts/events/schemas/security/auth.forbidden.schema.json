{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/security/auth.forbidden.schema.json",
  "title": "auth.forbidden",
  "description": "A valid credential lacks the required scope.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "actor",
    "action",
    "target",
    "required_scope"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "auth.forbidden"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "required_scope": {
      "type": "string"
    }
  },
  "x-requirement": "ENG-016"
}
