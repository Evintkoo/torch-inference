{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/models/model.download_progress.schema.json",
  "title": "model.download_progress",
  "description": "Transfer changes state or the progress interval elapses.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "task_id",
    "bytes_transferred",
    "percent"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "model.download_progress"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "bytes_transferred": {
      "type": "integer"
    },
    "bytes_total": {
      "type": [
        "integer",
        "null"
      ]
    },
    "percent": {
      "type": "number"
    }
  },
  "x-requirement": "ENG-005"
}
