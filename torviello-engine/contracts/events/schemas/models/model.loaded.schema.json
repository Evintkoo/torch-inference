{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/models/model.loaded.schema.json",
  "title": "model.loaded",
  "description": "A model slot reaches ready.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "model_id",
    "backend",
    "device",
    "precision",
    "load_duration_ms"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "model.loaded"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "precision": {
      "type": "string"
    },
    "load_duration_ms": {
      "type": "integer"
    }
  },
  "x-requirement": "ENG-006"
}
