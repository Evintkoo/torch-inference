{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/operations/log.accessed.schema.json",
  "title": "log.accessed",
  "description": "A diagnostic log is read or cleared.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "actor",
    "file_name",
    "action",
    "outcome"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "log.accessed"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "action": {
      "type": "string"
    }
  },
  "x-requirement": "ENG-020"
}
