{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/lifecycle/engine.stopped.schema.json",
  "title": "engine.stopped",
  "description": "Process is about to exit.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "drain_duration_ms",
    "completed_count",
    "cancelled_count",
    "forced"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "engine.stopped"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "drain_duration_ms": {
      "type": "integer"
    },
    "completed_count": {
      "type": "integer"
    },
    "cancelled_count": {
      "type": "integer"
    },
    "forced": {
      "type": "boolean"
    }
  },
  "x-requirement": "ENG-002"
}
