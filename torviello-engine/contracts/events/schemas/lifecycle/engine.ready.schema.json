{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torviello.local/contracts/events/schemas/lifecycle/engine.ready.schema.json",
  "title": "engine.ready",
  "description": "Required components are ready.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "profile_id",
    "engine_version",
    "backend",
    "model_count",
    "bind_addresses"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "engine.ready"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "cancelled",
        "denied"
      ]
    },
    "error_code": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "model_count": {
      "type": "integer"
    },
    "bind_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-requirement": "ENG-002"
}
