{
  "version": 1,
  "title": "Torviello system blueprint",
  "description": "Runtime services, module boundaries, data stores, external dependencies, and delivery paths. Planned nodes are scaffold targets, not conformance evidence.",
  "branches": [
    {
      "id": "clients-and-entry",
      "label": "Clients and entry points",
      "nodes": [
        {
          "id": "operator_web",
          "label": "Operator console",
          "kind": "client",
          "status": "implemented",
          "path": "web/src"
        },
        {
          "id": "landing",
          "label": "Marketing site",
          "kind": "client",
          "status": "planned",
          "path": "torviello-landing"
        },
        {
          "id": "api_client",
          "label": "API client",
          "kind": "external",
          "status": "implemented"
        },
        {
          "id": "tls_proxy",
          "label": "TLS 1.3 reverse proxy",
          "kind": "deployment",
          "status": "implemented",
          "path": "torviello-docs/docs/DEPLOYMENT.md"
        },
        {
          "id": "docs_site",
          "label": "Documentation site",
          "kind": "docs",
          "status": "implemented",
          "path": "torviello-docs"
        }
      ]
    },
    {
      "id": "engine-runtime",
      "label": "Engine runtime",
      "nodes": [
        {
          "id": "api_router",
          "label": "HTTP router and limits",
          "kind": "service",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/api.rs"
        },
        {
          "id": "auth",
          "label": "JWT authentication and RBAC",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/auth.rs"
        },
        {
          "id": "catalog",
          "label": "Catalog endpoints",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/api/catalog.rs"
        },
        {
          "id": "models_api",
          "label": "Model lifecycle endpoints",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/api/models.rs"
        },
        {
          "id": "classify_api",
          "label": "Classification endpoint",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/api/classify.rs"
        },
        {
          "id": "domain",
          "label": "Inference policy",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/domain.rs"
        },
        {
          "id": "model_manager",
          "label": "Model manager and single-flight load",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/runtime.rs"
        },
        {
          "id": "acquisition",
          "label": "Confined model acquisition",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/acquisition.rs"
        },
        {
          "id": "asset_store",
          "label": "Asset confinement and integrity",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/asset.rs"
        },
        {
          "id": "model_registry",
          "label": "Catalog parsing",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/model.rs"
        },
        {
          "id": "error_envelope",
          "label": "Problem details errors",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/error.rs"
        },
        {
          "id": "config",
          "label": "TOML and environment configuration",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/config.rs"
        }
      ]
    },
    {
      "id": "operations",
      "label": "Operations",
      "nodes": [
        {
          "id": "health",
          "label": "Liveness and readiness",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/api/health.rs"
        },
        {
          "id": "metrics_endpoint",
          "label": "Prometheus exposition",
          "kind": "module",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/api/metrics.rs"
        },
        {
          "id": "logging",
          "label": "JSON logs and correlation IDs",
          "kind": "service",
          "status": "implemented",
          "path": "torviello-engine/services/engine/src/observability.rs"
        },
        {
          "id": "prometheus",
          "label": "Prometheus server",
          "kind": "external",
          "status": "implemented",
          "path": "torviello-serve/monitoring/prometheus/prometheus.yml"
        },
        {
          "id": "alerts",
          "label": "Alert rules",
          "kind": "deployment",
          "status": "implemented",
          "path": "torviello-serve/monitoring/prometheus/alerts.yml"
        },
        {
          "id": "otel",
          "label": "OpenTelemetry collector",
          "kind": "external",
          "status": "planned"
        },
        {
          "id": "dashboards",
          "label": "Grafana dashboards",
          "kind": "deployment",
          "status": "planned",
          "path": "torviello-serve/monitoring/dashboards"
        }
      ]
    },
    {
      "id": "data-stores",
      "label": "Data stores",
      "nodes": [
        {
          "id": "registry_file",
          "label": "Model registry TOML",
          "kind": "datastore",
          "status": "implemented",
          "path": "torviello-engine/config/model-registry.toml"
        },
        {
          "id": "model_assets",
          "label": "Model asset root",
          "kind": "datastore",
          "status": "implemented",
          "path": "torviello-engine/models"
        },
        {
          "id": "sqlite",
          "label": "SQLite metadata",
          "kind": "datastore",
          "status": "planned",
          "path": "torviello-engine/services/engine/src/persistence.rs"
        },
        {
          "id": "migrations",
          "label": "Forward-only migrations",
          "kind": "datastore",
          "status": "implemented",
          "path": "torviello-engine/services/engine/migrations"
        }
      ]
    },
    {
      "id": "delivery",
      "label": "Build and deployment",
      "nodes": [
        {
          "id": "packaging_driver",
          "label": "Packaging driver",
          "kind": "pipeline",
          "status": "implemented",
          "path": "torviello-engine/packaging/torviello_package.py"
        },
        {
          "id": "engine_bundle",
          "label": "Engine-only bundle",
          "kind": "deployment",
          "status": "implemented",
          "path": "torviello-engine/packaging/packaging.toml"
        },
        {
          "id": "full_bundle",
          "label": "Full bundle",
          "kind": "deployment",
          "status": "planned",
          "path": "torviello-engine/packaging/packaging.toml"
        },
        {
          "id": "systemd",
          "label": "systemd unit",
          "kind": "deployment",
          "status": "implemented",
          "path": "torviello-engine/packaging/systemd/torviello-engine.service"
        },
        {
          "id": "container",
          "label": "Non-root container",
          "kind": "deployment",
          "status": "implemented",
          "path": "torviello-engine/containers/Dockerfile"
        },
        {
          "id": "ci_pipeline",
          "label": "CI and release workflows",
          "kind": "pipeline",
          "status": "implemented",
          "path": ".github/workflows"
        }
      ]
    },
    {
      "id": "cloud-and-external",
      "label": "Cloud and external dependencies",
      "nodes": [
        {
          "id": "cloud_accounts",
          "label": "Accounts and licensing service",
          "kind": "service",
          "status": "planned",
          "path": "torviello-cloud"
        },
        {
          "id": "platform_auth",
          "label": "Hosted login and entitlement check",
          "kind": "external",
          "status": "planned"
        },
        {
          "id": "huggingface",
          "label": "Hugging Face model host",
          "kind": "external",
          "status": "implemented"
        },
        {
          "id": "secret_manager",
          "label": "Secret manager",
          "kind": "external",
          "status": "implemented"
        }
      ]
    },
    {
      "id": "repo-areas",
      "label": "Repository areas",
      "nodes": [
        {
          "id": "benchmarks",
          "label": "Benchmarks and evaluations",
          "kind": "pipeline",
          "status": "implemented",
          "path": "torviello-bench/benchmarks"
        },
        {
          "id": "enforcer",
          "label": "Requirement controls",
          "kind": "docs",
          "status": "implemented",
          "path": "torviello-enforcer"
        },
        {
          "id": "media",
          "label": "Demo and marketing media",
          "kind": "docs",
          "status": "planned",
          "path": "torviello-media"
        },
        {
          "id": "design",
          "label": "Design system",
          "kind": "module",
          "status": "planned",
          "path": "torviello-design"
        }
      ]
    }
