{
  "name": "torviello-landing-web",
  "private": true,
  "type": "module",
  "description": "Torviello landing page — Svelte 5 app with Bun tooling.",
  "scripts": {
    "dev": "bunx --bun vite",
    "prebuild": "bun run scripts/seo-assets.ts",
    "build": "bunx --bun vite build",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bun test src",
    "test:interaction": "SVELTE_COMPILE_MODE=client bun test tests/interaction.test.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "latest",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
